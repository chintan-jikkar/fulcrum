{
  "name": "parity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "cd ../backend && uv run --frozen python -m app.openapi > ../packages/api-client/openapi.json && cd ../web && openapi-typescript ../packages/api-client/openapi.json -o ../packages/api-client/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
